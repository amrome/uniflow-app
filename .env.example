# Copy to .env and fill in (Supabase Dashboard > Project Settings > API).
# Restart Expo with `npx expo start --clear` after changing these.
# Use the anon/public key only. NEVER put the service_role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Demo mode: skip the login screens (see CLAUDE.md "Demo mode").
# Without a backend this opens the mock student Home. With a backend, also set a demo account.
EXPO_PUBLIC_SKIP_AUTH=1
# EXPO_PUBLIC_DEMO_EMAIL=demo@yu.edu.sa
# EXPO_PUBLIC_DEMO_PASSWORD=...
